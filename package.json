{
  "name": "majordomo",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "description": "Cross-platform tray inbox that unifies GitHub and self-hosted GitLab mentions",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/gnugomez/majordomo.git"
  },
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "pnpm build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "icons": "electron scripts/render-tray-icons.cjs",
    "icons:ico": "node scripts/make-ico.mjs",
    "package": "pnpm build && node scripts/make-icns.mjs && node scripts/package.mjs",
    "package:win": "pnpm build && node scripts/package.mjs --platform=win32 --arch=x64",
    "package:linux": "pnpm build && node scripts/package.mjs --platform=linux",
    "install:app": "node scripts/install.mjs"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@electron/packager": "^20.3.0",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@gitbeaker/rest": "^43.8.0",
    "@octokit/rest": "^22.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "electron": "^44.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-winstaller": "^5.4.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
