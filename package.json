{
  "name": "majordomo",
  "version": "0.2.1",
  "description": "macOS menu-bar inbox that unifies GitHub and self-hosted GitLab mentions",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/gnugomez/majordomo.git"
  },
  "main": "dist/main/index.js",
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "pnpm build && electron .",
    "typecheck": "tsc --noEmit",
    "icons": "electron scripts/render-tray-icons.cjs",
    "icons:ico": "node scripts/make-ico.mjs",
    "package": "pnpm build && node scripts/make-icns.mjs && node scripts/package.mjs",
    "package:win": "pnpm build && node scripts/package.mjs --platform=win32 --arch=x64",
    "package:linux": "pnpm build && node scripts/package.mjs --platform=linux"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@gitbeaker/rest": "^43.8.0",
    "@octokit/rest": "^22.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "electron": "^44.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-winstaller": "^5.4.4",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  }
}
