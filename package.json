{
  "name": "majordomo",
  "version": "0.1.0",
  "description": "macOS menu-bar inbox that unifies GitHub and self-hosted GitLab mentions",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "icons": "electron scripts/render-tray-icons.cjs",
    "package": "npm run build && node scripts/make-icns.mjs && node scripts/package.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.3.0",
    "electron": "^44.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
